rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: is user authenticated
    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // Guard against runaway client writes. NOTE: in Firestore rules,
    // `data.size()` returns the NUMBER OF FIELDS in the map, not bytes —
    // the old `< 524288` check was effectively a no-op (500K fields far
    // exceeds any legit doc). We now cap the field count at a generous
    // 80 (current Dispute docs use ~45 fields) and clamp the two known
    // unbounded string fields explicitly. Firestore rules cannot iterate
    // map values, so string caps are per-field; the 1 MiB server limit
    // remains the final backstop.
    function isReasonableSize() {
      return request.resource.data.size() <= 80
        && request.resource.data.get('description', '').size() <= 5000
        && request.resource.data.get('notes', '').size() <= 5000;
    }

    // users/{uid}
    match /users/{uid} {
      allow read: if isOwner(uid);
      // Allow create/update of the user root doc (profile + timestamps).
      // Clients call this on first launch to ensure the parent path exists.
      // The uid field is immutable on update so a buggy/malicious client
      // can't re-assign the doc's ownership marker to another uid.
      allow create: if isOwner(uid)
                    && request.resource.data.uid == uid
                    && isReasonableSize();
      allow update: if isOwner(uid)
                    && request.resource.data.uid == uid
                    && isReasonableSize();
      allow delete: if isOwner(uid);

      // users/{uid}/disputes/{disputeId}
      // `read` covers both get + list (collection queries on Home).
      match /disputes/{disputeId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
                      && request.resource.data.uid == uid
                      && isReasonableSize();
        allow update: if isOwner(uid)
                      && resource.data.uid == uid
                      && request.resource.data.uid == uid
                      && isReasonableSize();
        allow delete: if isOwner(uid)
                      && resource.data.uid == uid;
      }

      // users/{uid}/reminders/{reminderId}
      match /reminders/{reminderId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
                      && request.resource.data.uid == uid
                      && isReasonableSize();
        // Mirror the disputes block: both the existing resource AND the
        // incoming write must still own the same uid. Prevents a reminder
        // `update` from silently re-assigning it to another uid string.
        allow update: if isOwner(uid)
                      && resource.data.uid == uid
                      && request.resource.data.uid == uid
                      && isReasonableSize();
        allow delete: if isOwner(uid)
                      && resource.data.uid == uid;
      }
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}