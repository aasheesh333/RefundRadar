<?xml version="1.0" encoding="utf-8"?>
<!-- allowBackup=false means nothing is backed up; these rules exist only as
     defence-in-depth documentation for reviewers and to keep the manifest
     references valid. All SharedPreferences (parsed bank SMS data, AI quota
     state) and Firestore cache stay device-local. -->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
</full-backup-content>
